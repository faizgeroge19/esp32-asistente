# Copia este archivo como .env y pega tu dirección del punto de acceso MCP
# (consola xiaozhi.me → 配置 → 扩展能力 → MCP接入点 → botón copiar).
# El archivo .env NO se sube a git.
MCP_ENDPOINT=

# Wikipedia: contacto obligatorio en el User-Agent (una URL tuya, p. ej. tu perfil de GitHub, o un correo)
CONTACTO_WIKIPEDIA=

# Búsqueda web (opcional): clave gratuita de https://app.tavily.com (1000 búsquedas/mes, sin tarjeta)
TAVILY_API_KEY=
